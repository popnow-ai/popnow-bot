# PopNow bot configuration. Copy this file to .env and fill in the first block.
# Every line has a safe default except the three required ones.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Your PopNow API key (starts with sk-popnow-). Create a key just for this bot at
# https://popnow.ai/api/console/keys and give it a spend cap there: that cap is enforced by PopNow
# no matter what happens to the bot.
POPNOW_API_KEY=

# Telegram bot token from @BotFather. Leave empty to run Discord only.
TELEGRAM_BOT_TOKEN=

# Your own user ID. You are the owner: always allowed, not bound by the per-person daily limit,
# and the only one who sees the account balance. Several IDs are separated by commas.
# Prefix with tg: or dc: to pin an ID to one platform, e.g. OWNER_ID=tg:123456789,dc:987654321098765432
# Don't know your ID? Set OWNER_ID=0, start the bot and send it a message: it replies with your ID.
OWNER_ID=

# ---------------------------------------------------------------------------
# Discord (optional)
# ---------------------------------------------------------------------------

# Bot token from the Discord Developer Portal. Leave empty to run Telegram only.
DISCORD_TOKEN=
# Register commands on one server only; they appear instantly instead of after a short global rollout.
DISCORD_GUILD_ID=

# ---------------------------------------------------------------------------
# Who may use the bot
# ---------------------------------------------------------------------------

# Extra people allowed in private chats / DMs, besides the owner. Empty = only you.
# "*" lets ANYONE who finds the bot spend your credits. Don't, unless you mean it.
ALLOWED_USER_IDS=
# Groups (Telegram) or channels / servers (Discord) where the bot answers. Empty = no groups at all.
# Every member of a listed group can use the bot (within the daily limits below).
# Telegram group IDs are negative, e.g. -1001234567890.
ALLOWED_CHAT_IDS=
# Ask each person once to accept the short usage rules before their first generation.
REQUIRE_CONSENT=true

# ---------------------------------------------------------------------------
# Spending limits (PopNow credits, 1 credit = $0.01)
# ---------------------------------------------------------------------------

# Whole bot, per UTC day. Counts finished charges plus generations still running.
DAILY_BUDGET_CREDITS=500
# Per person, per UTC day (owners are only bound by DAILY_BUDGET_CREDITS).
USER_DAILY_BUDGET_CREDITS=100
# A single request that could cost more than this is refused before anything is charged.
MAX_CREDITS_PER_REQUEST=100
# Requests that could cost more than this show the price and wait for a tap on Confirm.
CONFIRM_ABOVE_CREDITS=10
# Images and videos one person may have running at the same time.
MAX_CONCURRENT_TASKS_PER_USER=2

# ---------------------------------------------------------------------------
# Models and output
# ---------------------------------------------------------------------------

# Defaults for everyone; each person can change theirs with /models.
DEFAULT_IMAGE_MODEL=alibaba/z-image-turbo/text-to-image
DEFAULT_VIDEO_MODEL=minimax/h3/text-to-video
DEFAULT_ANIMATE_MODEL=minimax/h3/image-to-video
# Limit the /models menus. Exact IDs or prefixes ending in *, e.g. alibaba/*,minimax/h3/image-to-video
ALLOWED_MODELS=
# Video length in seconds and resolution; snapped to what each model allows. Shorter and lower is cheaper.
VIDEO_SECONDS=5
VIDEO_RESOLUTION=480p
# Image aspect ratio such as 1:1, 16:9 or 9:16 (only used when the model offers it). Empty = model default.
IMAGE_ASPECT_RATIO=
# Video effect presets (see README). Set to off to hide /effect, /effects and the Effects button.
EFFECTS_FILE=effects/default.json
# Allow using photos people upload for Animate and effects (instead of only images the bot made).
# Off by default: turning it on lets anyone you allow animate a photo of a real person.
ALLOW_PHOTO_UPLOADS=false
# Ask PopNow to delete results and prompts after this many seconds (shorter than the account default).
RETENTION_SECONDS=

# ---------------------------------------------------------------------------
# Running
# ---------------------------------------------------------------------------

# Where the spend ledger and settings are stored. The Docker image uses /data (a volume);
# set this only when running with npm start (default ./data).
# DATA_DIR=./data
# Seconds between progress updates on a running video (Telegram allows about 20 edits a minute in groups).
PROGRESS_INTERVAL_SECONDS=6
